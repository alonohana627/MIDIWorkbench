# Generates generated/mwb/third_party_notices.cpp from deps/manifest.json (specification section
# 4.4.3: the About box's third-party notices come from the manifest, with every license text).

function(mwb_generate_third_party_notices output)
  file(READ "${PROJECT_SOURCE_DIR}/deps/manifest.json" manifest)
  string(JSON count LENGTH "${manifest}" dependencies)
  math(EXPR last "${count} - 1")
  set(entries "")
  foreach(index RANGE ${last})
    string(JSON name GET "${manifest}" dependencies ${index} name)
    string(JSON version GET "${manifest}" dependencies ${index} version)
    string(JSON license GET "${manifest}" dependencies ${index} license)
    string(JSON homepage GET "${manifest}" dependencies ${index} homepage)
    string(JSON purpose GET "${manifest}" dependencies ${index} purpose)
    string(JSON license_file GET "${manifest}" dependencies ${index} license_file)
    file(READ "${PROJECT_SOURCE_DIR}/deps/${name}/${license_file}" license_text)
    if(license_file STREQUAL "sqlite3.h")
      # SQLite is public domain; quote only its blessing instead of the whole header.
      set(license_text "The author disclaims copyright to this source code. In place of a legal notice, here is a blessing:\n\n   May you do good and not evil.\n   May you find forgiveness for yourself and forgive others.\n   May you share freely, never taking more than you give.\n")
    endif()
    # Raw string literal with a delimiter that cannot occur in license texts.
    string(APPEND entries "    {\"${name}\", \"${version}\", \"${license}\", \"${homepage}\", \"${purpose}\",\n     R\"MWBLICENSE(${license_text})MWBLICENSE\"},\n")
  endforeach()
  file(WRITE "${output}.tmp" "// Generated by cmake/ThirdPartyNotices.cmake from deps/manifest.json. Do not edit.\n#include \"mwb/app/third_party.hpp\"\n\nnamespace mwb::app {\n\nconst std::vector<ThirdPartyNotice>& third_party_notices() {\n  static const std::vector<ThirdPartyNotice> notices = {\n${entries}  };\n  return notices;\n}\n\n} // namespace mwb::app\n")
  file(COPY_FILE "${output}.tmp" "${output}" ONLY_IF_DIFFERENT)
  file(REMOVE "${output}.tmp")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/deps/manifest.json")
endfunction()
