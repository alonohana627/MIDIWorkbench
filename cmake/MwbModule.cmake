# mwb_module(<name> [MODULES <module>...] [LIBRARIES <target>...] [QT])
#
# Declares one static library mwb_<name> (alias mwb::<name>) built from src/<name>/*.cpp with
# headers in include/mwb/<name>/. MODULES is the complete list of project modules this module
# may include; the include-graph CTest entry fails when a source includes anything else
# (specification section 19.1). LIBRARIES are vendored or system targets.

set(MWB_OWNED_WARNINGS
  -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wshadow -Wold-style-cast
  -Wswitch-enum)

function(mwb_apply_owned_options target)
  target_compile_options(${target} PRIVATE ${MWB_OWNED_WARNINGS})
  if(MWB_WERROR)
    target_compile_options(${target} PRIVATE -Werror)
  endif()
  target_compile_features(${target} PUBLIC cxx_std_23)
endfunction()

function(mwb_module name)
  cmake_parse_arguments(ARG "QT" "" "MODULES;LIBRARIES" ${ARGN})
  file(GLOB sources CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/src/${name}/*.cpp"
    "${PROJECT_SOURCE_DIR}/src/${name}/detail/*.cpp")
  file(GLOB headers CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/include/mwb/${name}/*.hpp"
    "${PROJECT_SOURCE_DIR}/include/mwb/${name}/detail/*.hpp")
  if(NOT sources)
    # A module without sources yet is header-only during development.
    add_library(mwb_${name} INTERFACE)
    add_library(mwb::${name} ALIAS mwb_${name})
    target_include_directories(mwb_${name} INTERFACE "${PROJECT_SOURCE_DIR}/include")
    foreach(dependency IN LISTS ARG_MODULES)
      target_link_libraries(mwb_${name} INTERFACE mwb::${dependency})
    endforeach()
    if(ARG_LIBRARIES)
      target_link_libraries(mwb_${name} INTERFACE ${ARG_LIBRARIES})
    endif()
    list(JOIN ARG_MODULES "," joined_modules)
    set_property(GLOBAL APPEND PROPERTY MWB_MODULE_GRAPH "${name}:${joined_modules}")
    return()
  endif()
  add_library(mwb_${name} STATIC ${sources} ${headers})
  add_library(mwb::${name} ALIAS mwb_${name})
  target_include_directories(mwb_${name} PUBLIC "${PROJECT_SOURCE_DIR}/include")
  mwb_apply_owned_options(mwb_${name})
  foreach(dependency IN LISTS ARG_MODULES)
    target_link_libraries(mwb_${name} PUBLIC mwb::${dependency})
  endforeach()
  if(ARG_LIBRARIES)
    target_link_libraries(mwb_${name} PUBLIC ${ARG_LIBRARIES})
  endif()
  if(ARG_QT)
    set_target_properties(mwb_${name} PROPERTIES AUTOMOC ON)
  endif()
  list(JOIN ARG_MODULES "," joined_modules)
    set_property(GLOBAL APPEND PROPERTY MWB_MODULE_GRAPH "${name}:${joined_modules}")
endfunction()

# Writes build/include_graph.json from every mwb_module() declaration.
function(mwb_write_include_graph)
  get_property(entries GLOBAL PROPERTY MWB_MODULE_GRAPH)
  set(json "{\n")
  set(first TRUE)
  foreach(entry IN LISTS entries)
    string(FIND "${entry}" ":" colon)
    string(SUBSTRING "${entry}" 0 ${colon} module)
    math(EXPR start "${colon} + 1")
    string(SUBSTRING "${entry}" ${start} -1 joined)
    string(REPLACE "," ";" dependencies "${joined}")
    set(quoted "")
    foreach(dependency IN LISTS dependencies)
      if(dependency)
        list(APPEND quoted "\"${dependency}\"")
      endif()
    endforeach()
    list(JOIN quoted ", " joined)
    if(NOT first)
      string(APPEND json ",\n")
    endif()
    set(first FALSE)
    string(APPEND json "  \"${module}\": [${joined}]")
  endforeach()
  string(APPEND json "\n}\n")
  file(WRITE "${PROJECT_BINARY_DIR}/include_graph.json" "${json}")
endfunction()

# mwb_test_suite(<area> MODULES <module>...)
# Builds tests/<area>_tests.cpp into mwb_<area>_tests and registers one CTest entry per doctest
# TEST_SUITE plus a catch-all for cases outside named suites (specification section 32.2).
function(mwb_test_suite area)
  cmake_parse_arguments(ARG "QT" "" "MODULES;LIBRARIES;SOURCES" ${ARGN})
  set(source "${PROJECT_SOURCE_DIR}/tests/${area}_tests.cpp")
  add_executable(mwb_${area}_tests ${source} ${ARG_SOURCES})
  mwb_apply_owned_options(mwb_${area}_tests)
  target_link_libraries(mwb_${area}_tests PRIVATE mwb_test_support)
  foreach(dependency IN LISTS ARG_MODULES)
    target_link_libraries(mwb_${area}_tests PRIVATE mwb::${dependency})
  endforeach()
  if(ARG_LIBRARIES)
    target_link_libraries(mwb_${area}_tests PRIVATE ${ARG_LIBRARIES})
  endif()
  if(ARG_QT)
    set_target_properties(mwb_${area}_tests PROPERTIES AUTOMOC ON)
  endif()
  file(READ "${source}" content)
  string(REGEX MATCHALL "TEST_SUITE\\(\"[^\"]+\"\\)" suites "${content}")
  set(names "")
  foreach(suite IN LISTS suites)
    string(REGEX REPLACE "TEST_SUITE\\(\"([^\"]+)\"\\)" "\\1" suite_name "${suite}")
    list(APPEND names "${suite_name}")
  endforeach()
  list(REMOVE_DUPLICATES names)
  set(excluded "")
  foreach(suite_name IN LISTS names)
    add_test(NAME ${area}.${suite_name}
      COMMAND mwb_${area}_tests --test-suite=${suite_name} --mwb-require-tests)
    set_tests_properties(${area}.${suite_name} PROPERTIES ENVIRONMENT
      "QT_QPA_PLATFORM=offscreen;MWB_AUDIO_BACKEND=null;MWB_MIDI_BACKEND=null")
    list(APPEND excluded "${suite_name}")
  endforeach()
  list(JOIN excluded "," excluded_joined)
  if(excluded_joined)
    add_test(NAME ${area}.unnamed COMMAND mwb_${area}_tests --test-suite-exclude=${excluded_joined})
  else()
    add_test(NAME ${area}.unnamed COMMAND mwb_${area}_tests)
  endif()
  set_tests_properties(${area}.unnamed PROPERTIES ENVIRONMENT
    "QT_QPA_PLATFORM=offscreen;MWB_AUDIO_BACKEND=null;MWB_MIDI_BACKEND=null")
endfunction()
